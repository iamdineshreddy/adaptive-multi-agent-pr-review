# Copy to .env and fill in. Nothing here is a real secret — `.env` is
# gitignored; this template is documentation only.

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=adaptive
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adaptive_review

# --- App environment ---------------------------------------------------------
# development (default) skips the production secret validator; production
# requires ADAPTIVE_SECRET_KEY + ADAPTIVE_GITHUB_WEBHOOK_SECRET set.
ADAPTIVE_ENV=development
ADAPTIVE_LOG_LEVEL=info

# --- API bearer tokens (dashboard + Prometheus scrape) -----------------------
# Prometheus scrapes with ADAPTIVE_API_TOKEN (the raw value); the app only ever
# stores SHA-256 digests. Generate a token and its digest with:
#   python -c "import hashlib;print(hashlib.sha256(b'<token>').hexdigest())"
ADAPTIVE_API_TOKEN=change-me
ADAPTIVE_API_TOKEN_HASHES=["<sha256-of-the-token-above>"]
ADAPTIVE_API_TOKEN_ROLES={"<sha256-of-the-token-above>":"viewer"}

# --- Webhook / security secrets ----------------------------------------------
ADAPTIVE_SECRET_KEY=
ADAPTIVE_GITHUB_WEBHOOK_SECRET=

# --- GitHub App (empty boots fine; required for real PR ingestion) ------------
ADAPTIVE_GITHUB_APP_ID=
ADAPTIVE_GITHUB_APP_PRIVATE_KEY=
ADAPTIVE_GITHUB_PAT=

# --- LLM ---------------------------------------------------------------
# mock boots offline (deterministic); openai/anthropic need keys below.
ADAPTIVE_LLM_PROVIDER=mock
ADAPTIVE_OPENAI_API_KEY=
ADAPTIVE_ANTHROPIC_API_KEY=

# --- Observability ---------------------------------------------------------------
ADAPTIVE_PROMETHEUS_ENABLED=true
ADAPTIVE_LANGFUSE_PUBLIC_KEY=
ADAPTIVE_LANGFUSE_SECRET_KEY=
ADAPTIVE_LANGFUSE_HOST=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Scheduler cadence -----------------------------------------------------------
ADAPTIVE_SCHEDULER_INTERVAL_SECONDS=30