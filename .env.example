# Copy to .env and fill in real values. NEVER commit .env.

# --- Environment ------------------------------------------------------------
ADAPTIVE_ENV=development
ADAPTIVE_DEBUG=true

# --- Security ---------------------------------------------------------------
ADAPTIVE_SECRET_KEY=
ADAPTIVE_GITHUB_WEBHOOK_SECRET=

# --- GitHub ----------------------------------------------------------------
ADAPTIVE_GITHUB_APP_ID=
ADAPTIVE_GITHUB_APP_PRIVATE_KEY=
ADAPTIVE_GITHUB_PAT=

# --- Infrastructure ----------------------------------------------------------
ADAPTIVE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adaptive_review
ADAPTIVE_REDIS_URL=redis://localhost:6379/0

# --- LLM --------------------------------------------------------------------
ADAPTIVE_LLM_PROVIDER=openai
ADAPTIVE_LLM_MODEL_DEFAULT=gpt-4o-mini
ADAPTIVE_LLM_EMBEDDING_MODEL=text-embedding-3-small
ADAPTIVE_OPENAI_API_KEY=
ADAPTIVE_ANTHROPIC_API_KEY=

# --- ARUM -------------------------------------------------------------------
ADAPTIVE_ARUM_WEIGHTS_VERSION=v1
ADAPTIVE_ARUM_TEMPORAL_DECAY_DAYS=90
ADAPTIVE_ARUM_DECAY_LAMBDA=1.0

# --- Feedback loop ----------------------------------------------------------
ADAPTIVE_RATE_LIMIT_FEEDBACK_PER_MINUTE=120
# Never train weight candidates on fewer labelled decisions than this.
ADAPTIVE_LEARNING_MIN_EXAMPLES=20

# --- Review budget ----------------------------------------------------------
ADAPTIVE_REVIEW_BUDGET_LOW=5
ADAPTIVE_REVIEW_BUDGET_MEDIUM=10
ADAPTIVE_REVIEW_BUDGET_HIGH=20

# --- Observability ----------------------------------------------------------
ADAPTIVE_LANGFUSE_PUBLIC_KEY=
ADAPTIVE_LANGFUSE_SECRET_KEY=
ADAPTIVE_LANGFUSE_HOST=